msgid "Custom selection"
msgstr "اختيار مخصص"

msgctxt "ControlChartTests|"
msgid "One point outside of control limits - Test 1: Beyond limit"
msgstr "نقطة واحدة خارج حدود الضبط - الاختبار 1: تجاوز حد الضبط"

msgctxt "ControlChartTests|"
msgid "points in a row, on the same side of center line - Test 2: Shift"
msgstr "نقاط متتالية على الجانب نفسه من خط المركز - الاختبار 2: انزياح"

msgctxt "ControlChartTests|"
msgid "points in a row, all increasing or decreasing - Test 3: Trend"
msgstr "نقاط متتالية تتزايد جميعها أو تتناقص - الاختبار 3: اتجاه"

msgctxt "ControlChartTests|"
msgid ""
"out of k+1 points > 2 std. dev. from center line (same side) - Test 4: "
"Increasing variation"
msgstr ""
"من أصل k+1 نقطة تبعد > 2 انحراف معياري عن خط المركز (في الجانب نفسه) - "
"الاختبار 4: تزايد التشتت"

msgctxt "ControlChartTests|"
msgid ""
"points in a row < 1 std. dev from center line (either side) - Test 5: "
"Reducing variation"
msgstr ""
"نقاط متتالية تبعد < 1 انحراف معياري عن خط المركز (في أيٍّ من الجانبين) - "
"الاختبار 5: انخفاض التشتت"

msgctxt "ControlChartTests|"
msgid ""
"points in a row > 1 std. dev from center line (either side) - Test 6: "
"Bimodal distribution"
msgstr ""
"نقاط متتالية تبعد > 1 انحراف معياري عن خط المركز (في أيٍّ من الجانبين) - "
"الاختبار 6: توزيع ثنائي المنوال"

msgctxt "ControlChartTests|"
msgid ""
"out of k+1 points > 1 std. dev. from center line (same side) - Test 7: "
"Slightly increasing variation"
msgstr ""
"من أصل k+1 نقطة تبعد > 1 انحراف معياري عن خط المركز (في الجانب نفسه) - "
"الاختبار 7: تزايد طفيف في التشتت"

msgctxt "ControlChartTests|"
msgid ""
"points in a row, alternating increase and decrease - Test 8: Oscillation"
msgstr "نقاط متتالية تتناوب بين الزيادة والنقصان - الاختبار 8: تذبذب"

